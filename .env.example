# Copia este archivo a `.env` y completa los valores. `.env` nunca se sube al repo.

# --- LLM (Groq) ---
GROQ_API_KEY=
VISION_MODEL=qwen/qwen3.8-27b
REASONING_MODEL=openai/gpt-oss-120b

# --- App ---
ENVIRONMENT=local          # local | test | demo | production
LOG_LEVEL=INFO
LOG_JSON=false

# --- Base de datos ---
# En docker-compose se sobrescribe para apuntar al servicio `db`.
DATABASE_URL=postgresql+psycopg://opsagent:opsagent@localhost:5433/opsagent
